# ---- Agile Begins environment template -------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# The single-source `.env` is loaded by Next.js (dev/build) and by the
# `npm run db:*` seed scripts automatically.

# MongoDB connection string (Atlas or local) and database name.
# Use a real app database name — never the Mongo system db "local".
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?appName=example
DB_NAME=agilebegins

# JWT signing secrets — long random strings (e.g. generated by
# `openssl rand -hex 32`). Different values for access and refresh.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# SMTP provider (nodemailer) for confirmation emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me
EMAIL_FROM=Agile Begins <no-reply@agilebegins.com>
SUPPORT_EMAIL=support@agilebegins.com

# Admin account seeded by `npm run db:admin` (upserts by email).
ADMIN_EMAIL=admin@agilebegins.com
ADMIN_PASSWORD=change-me-strong

# UPI payment details shown on the /register payment step.
UPI_ID=you@upi
UPI_QR_SRC=/upi-qr.svg

# Public app URL used in emails.
APP_URL=http://localhost:3000

# Meeting link embedded in the confirmation email.
WORKSHOP_MEETING_LINK=https://meet.google.com/example

# Success-screen community link.
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/example

# Client-exposed copies (prefixed NEXT_PUBLIC_ are bundled client-side).
NEXT_PUBLIC_UPI_ID=you@upi
NEXT_PUBLIC_UPI_QR_SRC=/upi-qr.svg
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/example
